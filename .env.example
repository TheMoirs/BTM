# Database - Use Neon connection string (pooling)
DATABASE_URL="postgresql://user:password@ep-xxxxx.us-east-1.neon.tech/neondb?sslmode=require"

# Sign in with Google (optional) - OAuth "Web application" client ID from Google Cloud Console.
# Add your site addresses (e.g. https://btm-7tr5.onrender.com and http://localhost:5000)
# under "Authorised JavaScript origins". Leave unset to hide the Google button.
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# Session
SESSION_SECRET="your_session_secret_key"

# Resend Email (also used for "Forgot password" emails)
RESEND_API_KEY="your_resend_api_key"
RESEND_FROM_EMAIL="BTM <noreply@your-verified-domain>"

# GitHub Integration
GITHUB_TOKEN="your_github_token"

# Public address used in share links and emails (your own domain, no trailing slash)
PUBLIC_URL="https://btm.themoirs.uk"

# Application
NODE_ENV="development"
PORT="5000"

# Stripe: test and live keys side by side. The system admin picks the mode for the
# Unlimited plan (Users → Payments); each tournament picks it for captain payments.
STRIPE_TEST_SECRET_KEY=
STRIPE_LIVE_SECRET_KEY=
# Older single key (still works; counts as test or live by its prefix)
STRIPE_SECRET_KEY=
# "Your account" webhook (Unlimited plan), one signing secret per mode
STRIPE_WEBHOOK_SECRET_TEST=
STRIPE_WEBHOOK_SECRET_LIVE=
# "Connected accounts" webhook (captain card payments), one signing secret per mode
STRIPE_CONNECT_WEBHOOK_SECRET_TEST=
STRIPE_CONNECT_WEBHOOK_SECRET_LIVE=
